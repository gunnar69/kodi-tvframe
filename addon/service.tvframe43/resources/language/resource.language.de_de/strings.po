msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: de_DE\n"

msgctxt "#32000"
msgid "General"
msgstr "Allgemein"

msgctxt "#32001"
msgid "Enable TV frame"
msgstr "TV-Rahmen aktiv"

msgctxt "#32002"
msgid "Show TV cabinet overlay"
msgstr "Fernsehgehäuse einblenden"

msgctxt "#32004"
msgid "4:3 from aspect ratio"
msgstr "4:3 ab Seitenverhältnis"

msgctxt "#32005"
msgid "4:3 up to aspect ratio"
msgstr "4:3 bis Seitenverhältnis"

msgctxt "#32006"
msgid "Also for live TV"
msgstr "Auch bei Live-TV"

msgctxt "#32007"
msgid "Debug logging"
msgstr "Ausführliches Protokoll"

msgctxt "#32008"
msgid "Also for widescreen films (2.35:1)"
msgstr "Auch bei Breitbild-Filmen (2,35:1)"

msgctxt "#32011"
msgid "Turns the feature on or off."
msgstr "Schaltet die Funktion ein oder aus."

msgctxt "#32012"
msgid "Without the cabinet the picture is only shrunk."
msgstr "Ohne Gehäuse wird nur verkleinert."

msgctxt "#32014"
msgid "Videos within this aspect ratio range count as 4:3 (4:3 = 1.33)."
msgstr "Videos mit Seitenverhältnis in diesem Bereich gelten als 4:3 (4:3 = 1,33)."

msgctxt "#32016"
msgid "By default only for movies, episodes and files."
msgstr "Standardmäßig nur bei Filmen, Serien und Dateien."

msgctxt "#32018"
msgid "Cinemascope films get a TV with a broad frame above and below that hides the black bars."
msgstr "Cinemascope-Filme bekommen einen Fernseher mit breitem Rahmen oben und unten, der die schwarzen Balken verdeckt."

msgctxt "#32100"
msgid "Frame"
msgstr "Rahmen"

msgctxt "#32101"
msgid "Frame style"
msgstr "Rahmen-Stil"

msgctxt "#32102"
msgid "Own file for 4:3"
msgstr "Eigene Datei für 4:3"

msgctxt "#32103"
msgid "Own file for widescreen"
msgstr "Eigene Datei für Breitbild"

msgctxt "#32104"
msgid "Zoom 4:3 (0 = automatic)"
msgstr "Zoom 4:3 (0 = automatisch)"

msgctxt "#32105"
msgid "Zoom widescreen (0 = automatic)"
msgstr "Zoom Breitbild (0 = automatisch)"

msgctxt "#32111"
msgid "Each format has its own style; \"No frame\" leaves that format untouched. Zoom and vertical position are calculated from the screen area."
msgstr "Jedes Format hat seinen eigenen Stil; „Ohne Rahmen“ lässt dieses Format unangetastet. Zoom und Höhe werden aus der Mattscheibe berechnet. LG CX: außen echtes Schwarz, auf OLED verschmilzt es mit dem Rahmen."

msgctxt "#32112"
msgid "PNG, ideally 1920x1080, with a transparent screen area. The screen is detected automatically. Empty = no frame for this format."
msgstr "PNG, am besten 1920x1080, mit transparenter Mattscheibe. Die Mattscheibe wird automatisch erkannt. Leer = für dieses Format kein Rahmen."

msgctxt "#32114"
msgid "0 = calculated from the screen area. Otherwise this zoom is used."
msgstr "0 = aus der Mattscheibe berechnet. Sonst wird dieser Zoom verwendet."

msgctxt "#32200"
msgid "Detection"
msgstr "Erkennung"

msgctxt "#32201"
msgid "Widescreen from aspect ratio"
msgstr "Breitbild ab Seitenverhältnis"

msgctxt "#32202"
msgid "Widescreen up to aspect ratio"
msgstr "Breitbild bis Seitenverhältnis"

msgctxt "#32211"
msgid "Videos within this range get the widescreen frame (2.35:1 / 2.39:1)."
msgstr "Videos in diesem Bereich bekommen den Breitbild-Rahmen (2,35:1 / 2,39:1)."

msgctxt "#32130"
msgid "LG CX - 4:3 without stand"
msgstr "LG CX – 4:3 ohne Fuß"

msgctxt "#32131"
msgid "LG CX - 4:3 with stand"
msgstr "LG CX – 4:3 mit Fuß"

msgctxt "#32132"
msgid "50s wooden console (new)"
msgstr "50er Holztruhe (neu)"

msgctxt "#32133"
msgid "Flat A"
msgstr "Flach A"

msgctxt "#32134"
msgid "Flat B"
msgstr "Flach B"

msgctxt "#32135"
msgid "50s wooden console (old)"
msgstr "50er Holztruhe (alt)"

msgctxt "#32136"
msgid "60s space age (old)"
msgstr "60er Space-Age (alt)"

msgctxt "#32137"
msgid "70s orange plastic (old)"
msgstr "70er Orange-Kunststoff (alt)"

msgctxt "#32138"
msgid "80s silver/black (old)"
msgstr "80er Silber/Schwarz (alt)"

msgctxt "#32139"
msgid "Minimalist light grey (old)"
msgstr "Minimalistisch hellgrau (alt)"

msgctxt "#32140"
msgid "Retro monitor (old)"
msgstr "Retro-Monitor (alt)"

msgctxt "#32141"
msgid "Own file"
msgstr "Eigene Datei"

msgctxt "#32142"
msgid "LG CX - cabinet, fabric"
msgstr "LG CX – Gehäuse Stoff"

msgctxt "#32143"
msgid "LG CX - cabinet, metal"
msgstr "LG CX – Gehäuse Metall"

msgctxt "#32300"
msgid "Choose TV frame"
msgstr "Rahmen auswählen"

msgctxt "#32301"
msgid "active"
msgstr "aktiv"

msgctxt "#32302"
msgid "Frame off (this video only)"
msgstr "Rahmen aus (nur dieses Video)"

msgctxt "#32303"
msgid "Frame on again"
msgstr "Rahmen wieder an"

msgctxt "#32310"
msgid "Choose frame with preview…"
msgstr "Rahmen auswählen (mit Vorschau)…"

msgctxt "#32311"
msgid "Opens a list with preview images. During playback the frame changes immediately."
msgstr "Öffnet eine Liste mit Vorschaubildern. Während der Wiedergabe wird sofort umgeschaltet."

msgctxt "#32320"
msgid "Remote key for frame selection"
msgstr "Taste für Rahmen-Auswahl"

msgctxt "#32321"
msgid "Optional. Writes only the add-on's own keymap file (userdata/keymaps/tvframe43.xml) for fullscreen video; it is removed again when set to off. Long presses may not work on every remote."
msgstr "Optional. Schreibt nur die eigene Datei userdata/keymaps/tvframe43.xml (nur im Vollbild-Video) und entfernt sie bei „aus“ wieder. Langes Drücken funktioniert nicht mit jeder Fernbedienung."

msgctxt "#32322"
msgid "off"
msgstr "aus"

msgctxt "#32323"
msgid "Red button"
msgstr "Rote Taste"

msgctxt "#32324"
msgid "Menu button (long press)"
msgstr "Menütaste (lang drücken)"

msgctxt "#32325"
msgid "OK button (long press)"
msgstr "OK-Taste (lang drücken)"

msgctxt "#32330"
msgid "Also for 2:1 (styles with a 2:1 frame)"
msgstr "Auch bei 2:1 (Stile mit 2:1-Rahmen)"

msgctxt "#32331"
msgid "2:1 material (e.g. many series) gets its own frame where the style has one."
msgstr "2:1-Material (z.B. viele Serien) bekommt einen eigenen Rahmen, sofern der Stil einen hat."

msgctxt "#32332"
msgid "2:1 from aspect ratio"
msgstr "2:1 ab Seitenverhältnis"

msgctxt "#32333"
msgid "2:1 up to aspect ratio"
msgstr "2:1 bis Seitenverhältnis"

msgctxt "#32340"
msgid "Detect burned-in black bars"
msgstr "Eingebrannte Balken erkennen"

msgctxt "#32341"
msgid "Many cinemascope films are stored as a full 16:9 picture with the black bars inside the image. The add-on then measures the real picture height (still frames from the file, measured once per file and remembered) and shows the film with the widescreen or 2:1 frame. If the measurement is not certain, nothing changes."
msgstr "Viele Breitbild-Filme liegen als volles 16:9-Bild vor, die schwarzen Balken sind im Bild. Das Add-on misst dann die echte Bildhöhe (Einzelbilder aus der Datei, einmal pro Datei gemessen und gemerkt) und zeigt den Film mit dem Breitbild- bzw. 2:1-Rahmen. Ist die Messung nicht eindeutig, ändert sich nichts."

msgctxt "#32106"
msgid "Own file for 2:1"
msgstr "Eigene Datei für 2:1"

msgctxt "#32144"
msgid "LG CX"
msgstr "LG CX"

msgctxt "#32145"
msgid "Flat (A/B)"
msgstr "Flach (A/B)"

msgctxt "#32146"
msgid "LG CX - cabinet"
msgstr "LG CX – Gehäuse"

msgctxt "#32304"
msgid "No frame"
msgstr "Ohne Rahmen"

msgctxt "#32350"
msgid "Frame for %s"
msgstr "Rahmen für %s"

msgctxt "#32351"
msgid "Frame for 4:3"
msgstr "Rahmen für 4:3"

msgctxt "#32352"
msgid "Frame for widescreen (2.35:1)"
msgstr "Rahmen für Breitbild (2,35:1)"

msgctxt "#32353"
msgid "Frame for 2:1"
msgstr "Rahmen für 2:1"

msgctxt "#32360"
msgid "4:3"
msgstr "4:3"

msgctxt "#32361"
msgid "Widescreen 2.35:1"
msgstr "Breitbild 2,35:1"

msgctxt "#32362"
msgid "2:1"
msgstr "2:1"

msgctxt "#32147"
msgid "Design from the gallery"
msgstr "Design aus der Galerie"

msgctxt "#32312"
msgid "Designs from the gallery…"
msgstr "Designs aus der Galerie…"

msgctxt "#32313"
msgid "Downloads further frame designs from github.com/gunnar69/kodi-tvframe (data only, checksum-verified) into the add-on's profile folder. Installed designs then appear in the frame list of the formats they support. Own designs can be contributed there via pull request."
msgstr "Lädt weitere Rahmen-Designs von github.com/gunnar69/kodi-tvframe (nur Bilddaten, mit Prüfsumme) in den Profilordner des Add-ons. Installierte Designs erscheinen danach in der Rahmen-Liste der Formate, für die sie Dateien haben. Eigene Designs lassen sich dort per Pull Request beitragen."

msgctxt "#32400"
msgid "Design gallery"
msgstr "Design-Galerie"

msgctxt "#32402"
msgid "Download more frames (internet)"
msgstr "Weitere Rahmen herunterladen (Internet)"

msgctxt "#32403"
msgid "Gallery design (not installed)"
msgstr "Galerie-Design (nicht installiert)"

msgctxt "#32404"
msgid "by %s"
msgstr "von %s"

msgctxt "#32405"
msgid "installed"
msgstr "installiert"

msgctxt "#32406"
msgid "update available"
msgstr "Update verfügbar"

msgctxt "#32407"
msgid "not installed"
msgstr "nicht installiert"

msgctxt "#32408"
msgid "installed locally only (no longer in the gallery)"
msgstr "nur lokal installiert (nicht mehr in der Galerie)"

msgctxt "#32410"
msgid "Install"
msgstr "Installieren"

msgctxt "#32411"
msgid "Update"
msgstr "Aktualisieren"

msgctxt "#32412"
msgid "Download again"
msgstr "Erneut herunterladen"

msgctxt "#32413"
msgid "Remove"
msgstr "Entfernen"

msgctxt "#32414"
msgid "Really remove the design „%s“? Formats using it go back to the standard frame."
msgstr "Design „%s“ wirklich entfernen? Formate, die es nutzen, bekommen wieder den Standardrahmen."

msgctxt "#32415"
msgid "„%s“ installed – now selectable in the frame list."
msgstr "„%s“ installiert – jetzt in der Rahmen-Liste wählbar."

msgctxt "#32416"
msgid "„%s“ removed."
msgstr "„%s“ entfernt."

msgctxt "#32417"
msgid "Downloading design…"
msgstr "Design wird geladen…"

msgctxt "#32418"
msgid "Formats: %s – download now?"
msgstr "Formate: %s – jetzt herunterladen?"

msgctxt "#32419"
msgid "Gallery not reachable – showing installed designs only."
msgstr "Galerie nicht erreichbar – nur installierte Designs."

msgctxt "#32420"
msgid "The gallery cannot be reached. Please check the internet connection and try again later."
msgstr "Die Galerie ist nicht erreichbar. Bitte Internetverbindung prüfen und später erneut versuchen."

msgctxt "#32421"
msgid "The gallery server answered with an error (%s). Please try again later."
msgstr "Der Galerie-Server meldet einen Fehler (%s). Bitte später erneut versuchen."

msgctxt "#32422"
msgid "The gallery data are invalid or incomplete. Nothing was installed."
msgstr "Die Galerie-Daten sind ungültig oder unvollständig. Es wurde nichts installiert."

msgctxt "#32423"
msgid "Checksum mismatch for %s – the download is damaged or was altered. Nothing was installed."
msgstr "Prüfsumme von %s stimmt nicht – der Download ist beschädigt oder verändert. Es wurde nichts installiert."

msgctxt "#32424"
msgid "The design contains invalid file names or paths and was rejected for safety reasons. Nothing was installed."
msgstr "Das Design enthält unzulässige Dateinamen oder Pfade und wurde aus Sicherheitsgründen abgelehnt. Es wurde nichts installiert."

msgctxt "#32425"
msgid "A file is larger than announced or allowed. Nothing was installed."
msgstr "Eine Datei ist größer als angekündigt bzw. erlaubt. Es wurde nichts installiert."

msgctxt "#32426"
msgid "The secure connection to the gallery failed (certificate check)."
msgstr "Die sichere Verbindung zur Galerie ist fehlgeschlagen (Zertifikatsprüfung)."

msgctxt "#32427"
msgid "Cancelled."
msgstr "Abgebrochen."

msgctxt "#32428"
msgid "offline – last saved list"
msgstr "offline – zuletzt gespeicherte Liste"

msgctxt "#32429"
msgid "No designs found."
msgstr "Keine Designs gefunden."
